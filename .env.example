# Copy this file to .env and choose the two passwords. .env is never committed.
# On Linux and macOS, make it readable only by you: chmod 600 .env

# The local staging database started by docker compose. POSTGRES_* is the owner of the database;
# only the database container uses it.
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me

# The client's own database role, cdse_loader: it may write iris_staging and nothing else.
# Any character works in this password.
CDSE_DB_PASSWORD=change-me-too

# Where the client connects from your own machine: 127.0.0.1:5434 (not "localhost": Windows tries
# IPv6 first for "localhost" and waits 10 s per connection). Inside docker compose it is db:5432.
CDSE_DB_HOST=127.0.0.1
CDSE_DB_PORT=5434
CDSE_DB_NAME=iris
# Instead of the parts above, a full address also works (then encode special characters, @ as %40):
# DATABASE_URL=postgresql+psycopg://cdse_loader:change-me-too@127.0.0.1:5434/iris

# The tests use their own database, iris_test, and empty its tables.
CDSE_TEST_DB_NAME=iris_test
# Two tests also need the database owner, to create a schema named iris_core for a moment.
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://iris:change-me@127.0.0.1:5434/iris_test

# Optional. The search works without it; it is only sent if set.
CDSE_ACCESS_TOKEN=

LOG_LEVEL=INFO
